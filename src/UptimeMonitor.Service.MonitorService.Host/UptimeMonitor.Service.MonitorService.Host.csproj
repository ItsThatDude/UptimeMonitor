<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>dotnet-UptimeMonitor.Service.MonitorService.Host-53d44b1d-78ba-4a9a-9e86-91c80d89c46a</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.11" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.11" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.11" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../UptimeMonitor.Service.MonitorService/UptimeMonitor.Service.MonitorService.csproj" />
	</ItemGroup>

	<Target Name="CopyPlugins" AfterTargets="Build">
		<ItemGroup>
			<!-- Define plugin source paths -->
			<PluginDlls Include="..\UptimeMonitor.Monitors.HttpMonitor\bin\$(Configuration)\net8.0\*.*">
				<PluginDirectory>HttpMonitor</PluginDirectory>
			</PluginDlls>
			<PluginDlls Include="..\UptimeMonitor.Monitors.TcpMonitor\bin\$(Configuration)\net8.0\*.*">
				<PluginDirectory>TcpMonitor</PluginDirectory>
			</PluginDlls>
			<PluginDlls Include="..\UptimeMonitor.Monitors.PingMonitor\bin\$(Configuration)\net8.0\*.*">
				<PluginDirectory>PingMonitor</PluginDirectory>
			</PluginDlls>
		</ItemGroup>

		<!-- Copy each plugin to its own folder under the Plugins directory -->
		<Copy SourceFiles="@(PluginDlls)" DestinationFiles="@(PluginDlls->'$(OutputPath)\Plugins\%(PluginDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>
</Project>