{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "UiDevServerUrl": "http://localhost:4200",
  "ReverseProxy": {
    "Routes": {
      "favicon": {
        "ClusterId": "angular",
        "Match": {
          "Path": "favicon.ico"
        }
      },
      "logo": {
        "ClusterId": "angular",
        "Match": {
          "Path": "logo.svg"
        }
      },
      "config": {
        "ClusterId": "angular",
        "Match": {
          "Path": "config.json"
        }
      },
      "ng": {
        "ClusterId": "angular",
        "Match": {
          "Path": "@ng/{**catch-all}"
        }
      },
      "fs": {
        "ClusterId": "angular",
        "Match": {
          "Path": "@fs/{**catch-all}"
        }
      },
      "vite": {
        "ClusterId": "angular",
        "Match": {
          "Path": "@vite/{**catch-all}"
        }
      },
      "assets": {
        "ClusterId": "angular",
        "Match": {
          "Path": "assets/{**catch-all}"
        }
      },
      "media": {
        "ClusterId": "angular",
        "Match": {
          "Path": "media/{**catch-all}"
        }
      },
      "routealljs": {
        "ClusterId": "angular",
        "Match": {
          "Path": "{nomatterwhat}.js"
        }
      },
      "routeallcss": {
        "ClusterId": "angular",
        "Match": {
          "Path": "{nomatterwhat}.css"
        }
      },
      "routeallmap": {
        "ClusterId": "angular",
        "Match": {
          "Path": "{nomatterwhat}.map"
        }
      },
      "webpacklazyloadingsources": {
        "ClusterId": "angular",
        "Match": {
          "Path": "/src_{nomatterwhat}_ts.js"
        }
      },
      "signalr": {
        "ClusterId": "angular",
        "Match": {
          "Path": "/ng-cli-ws"
        }
      },
      "webpacknodesrcmap": {
        "ClusterId": "angular",
        "Match": {
          "Path": "/{nomatterwhat}.js.map"
        }
      }
    },
    "Clusters": {
      "angular": {
        "HttpClient": {
          "SslProtocols": [
            "Tls12"
          ]
        },
        "Destinations": {
          "angular/http": {
            "Address": "http://localhost:4200/"
          }
        }
      }
    }
  }
}